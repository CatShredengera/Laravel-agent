includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
    tmpDir: build/phpstan
    ignoreErrors:
        -
            # `Mobile_Detect` is mobiledetect/mobiledetectlib v2.x's class —
            # composer.json allows `^2.8.34 || ^4.0`, and whichever one is
            # NOT installed is, correctly, unresolvable here. This file is
            # only ever instantiated (via DriverFactory) when v2.x is what
            # actually got installed; verified against the real package by
            # temporarily requiring each range and running the full test
            # suite against both. See Support/ModernDriver.php for the same
            # situation in reverse.
            message: '#Instantiated class Mobile_Detect not found\.#'
            path: src/Support/LegacyDriver.php
            # Only ever fires when v4.x is what's actually installed (the
            # common case); harmless no-op the rest of the time.
            reportUnmatched: false
        -
            # Same situation, reversed — but subtler: v2.x *also* ships a
            # `Detection\MobileDetect` (namespaced/Detection/MobileDetect.php,
            # a one-line `class MobileDetect extends \Mobile_Detect {}` PSR-0
            # shim), so when v2.x is installed PHPStan doesn't report a
            # missing class here — it finds v2's *old*-API class under that
            # name and flags every v4-only member ModernDriver uses against
            # it. ModernDriver is only ever instantiated when v4.x actually
            # got installed (DriverFactory checks `Mobile_Detect` first), so
            # none of this is reachable when v2.x is what's resolved.
            message: '#^(Unknown parameter \$config in call to Detection\\MobileDetect constructor\.|Call to an undefined method Detection\\MobileDetect::(autoInitKnownHttpHeaders|hasUserAgent)\(\)\.)$#'
            path: src/Support/ModernDriver.php
            reportUnmatched: false
